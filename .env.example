# Copy to .env (never commit it) and fill in. Every variable is documented in
# docs/configuration.md.

# ---------------------------------------------------------------- required
# Generate each with: openssl rand -base64 32   (two DIFFERENT values)
JWT_SECRET=
# Encrypts TOTP secrets at rest. Back it up separately from the database:
# lose it and every user must re-enrol their authenticator app.
DATA_ENCRYPTION_KEY=

# How the app is opened in a browser. Emailed links and the passkey origin are
# built from it, and cookies become Secure when it starts with https://.
# Vite dev (bootRun + npm run dev): http://localhost:5173
# Full compose stack (nginx serves the SPA): http://localhost:8081
APP_BASE_URL=http://localhost:5173

# The first administrator. Sign up with this address and verify it; it is
# promoted while no administrator exists. Nothing is created or logged.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com

# ---------------------------------------------------------------- database
# Two logins (db/roles.sql; Compose's db-roles service creates them): the app
# signs in as bastion_app, which can only read and write rows, and runs
# migrations as bastion_owner. The passwords below are development defaults —
# the app refuses them once APP_BASE_URL names another host.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=bastion
DB_USER=bastion_app
DB_PASS=bastion-app-local
SPRING_FLYWAY_USER=bastion_owner
SPRING_FLYWAY_PASSWORD=bastion-owner-local
# The MySQL administrator; Compose only, never used by the app.
DB_ADMIN_PASSWORD=bastion
# The dev database requires TLS (MySQL's own certificate). Production: verify it:
# DB_PARAMS=&sslMode=VERIFY_IDENTITY

# -------------------------------------------------------------------- mail
# Leave unset in dev: everything goes to Mailpit (http://localhost:8025).
# MAIL_HOST=email-smtp.us-east-1.amazonaws.com
# MAIL_PORT=587
# MAIL_USER=
# MAIL_PASS=
# MAIL_SMTP_AUTH=true
# MAIL_STARTTLS=true
# MAIL_FROM=My App <no-reply@example.com>
# Dev addresses like admin@example.com publish no mail exchanger:
SIGNUP_CHECK_MX=false

# ----------------------------------------------------------------- network
CORS_ORIGINS=http://localhost:5173
# Only behind a reverse proxy that RESETS X-Forwarded-For (the bundled nginx does).
# TRUST_FORWARDED_FOR=true

# ---------------------------------------------------------------- optional
# APP_NAME=Bastion
# Cloudflare Turnstile CAPTCHA on signup/recovery (both keys, or neither):
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# PASSWORD_MIN_LENGTH=12
# SESSION_IDLE_DAYS=14
# SESSION_MAX_DAYS=30
# ADMIN_REQUIRES_MFA=true
# SPRING_PROFILES_ACTIVE=prod   # JSON logs
# Trying the app from another device on a private network over http? This skips
# the startup refusal of development settings. Never on a deployment.
# ALLOW_DEVELOPMENT_SETTINGS=true

# Copy to .env (never commit it) and fill in.

# REQUIRED. Generate: openssl rand -base64 32
JWT_SECRET=

# How the app is opened in a browser. Emailed links are built from this.
# Vite dev (bootRun + npm run dev): http://localhost:5173
# Full compose stack (nginx serves the SPA): http://localhost:8081
APP_BASE_URL=http://localhost:5173

# Database (dev defaults match docker-compose.yml)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=bastion
DB_USER=bastion
DB_PASS=bastion

# Mail. Leave unset in dev: everything goes to the Mailpit catcher
# (web UI: http://localhost:8025). For production point at any SMTP relay
# (AWS SES, Postmark, Mailgun, ...) and set MAIL_FROM to a verified sender.
# MAIL_HOST=email-smtp.us-east-1.amazonaws.com
# MAIL_PORT=587
# MAIL_USER=
# MAIL_PASS=
# MAIL_SMTP_AUTH=true
# MAIL_STARTTLS=true
# MAIL_FROM=My App <no-reply@example.com>

# CORS origins for the SPA during cross-origin dev (comma-separated).
CORS_ORIGINS=http://localhost:5173

# Only enable behind a reverse proxy that RESETS X-Forwarded-For.
# TRUST_FORWARDED_FOR=true
